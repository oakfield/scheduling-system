@page "/students"
@rendermode InteractiveServer
@using SchedulingSystem.Models
@using SchedulingSystem.Services
@inject IStudentService StudentService

<PageTitle>Students</PageTitle>

<h1>Students</h1>
<p>Search and filter students by their academic status. Filters combine (AND) across columns.</p>

@if (students is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>House</th>
                    <th>Year</th>
                    <th>Current Credits</th>
                    <th>Max Credits</th>
                    <th>Completed Courses</th>
                </tr>
                <tr>
                    <th><input class="form-control form-control-sm" placeholder="Filter..." @bind="nameFilter" @bind:event="oninput" /></th>
                    <th><input class="form-control form-control-sm" placeholder="Filter..." @bind="emailFilter" @bind:event="oninput" /></th>
                    <th><input class="form-control form-control-sm" placeholder="Filter..." @bind="houseFilter" @bind:event="oninput" /></th>
                    <th><input class="form-control form-control-sm" placeholder="Filter..." @bind="yearFilter" @bind:event="oninput" /></th>
                    <th><input class="form-control form-control-sm" placeholder="Filter..." @bind="currentCreditsFilter" @bind:event="oninput" /></th>
                    <th><input class="form-control form-control-sm" placeholder="Filter..." @bind="maxCreditsFilter" @bind:event="oninput" /></th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var student in FilteredStudents)
                {
                    <tr>
                        <td>@student.FullName</td>
                        <td>@student.Email</td>
                        <td>@student.HouseAffiliation</td>
                        <td>@student.YearLevel</td>
                        <td>@student.CurrentCredits</td>
                        <td>@student.MaxCreditsAllowed</td>
                        <td>
                            @if (student.CompletedCourseNumbers.Count == 0)
                            {
                                <span class="text-muted">None</span>
                            }
                            else
                            {
                                @string.Join(", ", student.CompletedCourseNumbers)
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <p class="text-muted">Showing @FilteredStudents.Count() of @students.Count students.</p>
}

@code {
    private IReadOnlyList<StudentListItem>? students;

    private string nameFilter = "";
    private string emailFilter = "";
    private string houseFilter = "";
    private string yearFilter = "";
    private string currentCreditsFilter = "";
    private string maxCreditsFilter = "";

    protected override async Task OnInitializedAsync()
    {
        students = await StudentService.GetStudentsAsync();
    }

    private IEnumerable<StudentListItem> FilteredStudents => (students ?? [])
        .Where(s => Matches(s.FullName, nameFilter))
        .Where(s => Matches(s.Email, emailFilter))
        .Where(s => Matches(s.HouseAffiliation, houseFilter))
        .Where(s => Matches(s.YearLevel, yearFilter))
        .Where(s => Matches(s.CurrentCredits, currentCreditsFilter))
        .Where(s => Matches(s.MaxCreditsAllowed, maxCreditsFilter));

    private static bool Matches(string value, string filter) =>
        string.IsNullOrWhiteSpace(filter) || value.Contains(filter, StringComparison.OrdinalIgnoreCase);

    private static bool Matches(int value, string filter) =>
        string.IsNullOrWhiteSpace(filter) || value.ToString().Contains(filter, StringComparison.OrdinalIgnoreCase);
}
